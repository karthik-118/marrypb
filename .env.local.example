# =============================================================
#  ENVIRONMENT VARIABLES  (for the "Send Wishes" live guestbook)
# =============================================================
#
# The website works WITHOUT these — wishes are saved in the visitor's
# own browser until you connect the database. Once MONGODB_URI is set,
# wishes are stored in MongoDB and shared with everyone.
#
# HOW TO GET IT (free — MongoDB Atlas):
#   1. Create a free cluster at https://www.mongodb.com/atlas
#   2. Database Access  -> add a database user (username + password)
#   3. Network Access   -> "Allow access from anywhere" (0.0.0.0/0)
#      (required so Vercel's serverless functions can connect)
#   4. Create a database (e.g. "wedding") + collection (e.g. "wishes")
#   5. Connect -> Drivers -> copy the connection string, put your
#      password in it, and paste it below.
#
# Then rename this file to ".env.local".
# On Vercel: add these three under Project -> Settings -> Environment Variables.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wedding
MONGODB_COLLECTION=wishes
